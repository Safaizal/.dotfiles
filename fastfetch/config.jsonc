// These presets are good 10,12, 20, 25, 26, 29, 31

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "/home/faizal/.config/fastfetch/logo/rei2.png",
    "color": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "6": "",
      "7": "",
      "8": "",
      "9": ""
    },
    "width": 40,
    "height": 23,
    "padding": {
      "top": 1,
      "left": 18,
      "bottom": 0,
      "right": 18
    },
    "printRemaining": true,
    "preserveAspectRatio": false,
    "recache": false,
    "position": "left",
    "chafa": {
      "fgOnly": false,
      "symbols": "block+border+space-wide-inverted"
    }
  },
    "display": {
        "pipe": false,
        "key": {
            "width": 16
        },
        "separator": "│ ",
        "percent": {
            "type": ["bar", "hide-others"]
        },
        "bar": {
            "border": null,
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "width": 40
        },
        "constants": [
            "\u001b[42C"
        ]
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌───────────────────────────────────────────────────────┐"
        },
        {
            "type": "version",
            "key": " ",
            "format": "│                   FASTFETCH v{version}                   │"
        },
        {
            "type": "custom",
            "format": "├────────────┬──────────────────────────────────────────┤"
        },
        {
            "type": "os",
            "key": "│ OS         │{$1}",
            "keyColor":"red"
        },
        {
            "type": "title",
            "key": "│ USER       │{$1}",
            "format": "{user-name}",
            "keyColor": "red"
        },
        {
            "type": "custom",
            "format": "├────────────┼──────────────────────────────────────────┤"
        },
        {
            "type": "title",
            "key": "│ HOSTNAME   │{$1}",
            "format": "{host-name}",
            "keyColor":"green"
        },
        {
            "type": "localip",
            "key": "│ CLIENT IP  │{$1}",
            "format": "{ipv4}",
            "keyColor":"green"
        },
        {
            "type": "localip",
            "key": "│ MAC ADDR   │{$1}",
            "format": "{mac} ({ifname})",
            "showIpv4": false,
            "showMac": true,
            "keyColor":"green"
        },
        {
          "type": "custom",
          "format": "├────────────┼──────────────────────────────────────────┤"
        },
        {
            "type": "host",
            "key": "│ MACHINE    │{$1}",
            "format": "{name}",
            "keyColor":"yellow"
        },
        {
            "type": "cpu",
            "key": "│ PROCESSOR  │{$1}",
            "format": "{name}",
            "keyColor":"yellow"
        },
        {
            "type": "cpu",
            "key": "│ CPU FREQ   │{$1}",
            "format": "{freq-max}{/freq-max}{freq-base}{/}",
            "keyColor":"yellow"
        },
        {
            "type": "custom",
            "format": "├────────────┼──────────────────────────────────────────┤"
        },
        {
            "type": "memory",
            "key": "│ MEMORY     │{$1}",
            "format": "{used} / {total} [{percentage}]",
            "percent": {
                "type": ["num"]
            },
            "keyColor":"blue"
        },
        {
            "type": "memory",
            "key": "│ USAGE      │{$1}",
            "format": "",
            "percent": {
                "type": ["bar", "hide-others"]
            },
            "keyColor":"blue"
        },
        {
            "type": "custom",
            "format": "├────────────┼──────────────────────────────────────────┤"
        },
        {
            "type": "disk",
            "key": "│ VOLUME     │{$1}",
            "format": "{size-used} / {size-total} [{size-percentage}]",
            "folders": "/",
            "percent": {
                "type": ["num"]
            },
            "keyColor":"magenta"
        },
        {
            "type": "disk",
            "key": "│ DISK USAGE │{$1}",
            "format": "",
            "percent": {
                "type": ["bar", "hide-others"]
            },
            "keyColor":"magenta"
        },
        {
            "type": "custom",
            "format": "├────────────┼──────────────────────────────────────────┤"
        },
        {
            "type": "users",
            "key": "│ LAST LOGIN │{$1}",
            "format": "{login-time}{?client-ip} ({client-ip})",
            "myselfOnly": true,
            "keyColor": "cyan"

        },
        {
            "type": "uptime",
            "key": "│ UPTIME     │{$1}",
            "keyColor": "cyan"
        },
        {
            "condition": {                                    // Conditional module: only show on non-macOS
                "!system": "macOS"
            },
            "type": "disk",
            "keyIcon": "",
            "key": "│ OS_Age     │{$1}",
            "folders": "/",                                   // Check root filesystem
            "format": "{create-time:10} [{days} days]",       // Show creation time and age in days
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "└────────────┴──────────────────────────────────────────┘"
        },
        {
            "type": "custom",
            "format": "│{#31} {#32} {#33} {#34} {#35} {#36} {#39}   --------{#32}{#39}--------    {#36} {#35} {#34} {#33} {#32} {#31}{#39}│"
        }
    ]
  }