{
    "layer": "top",
    "modules-left": [
        "wireplumber",
	    "temperature",
        "custom/cava",
        "custom/playing"
    ],
    "modules-center": [
        "hyprland/workspaces"
    ],
    "modules-right": [
      	"network",
        "battery",
        "clock"
    ],
    "hyprland/window": {
        "max-length": 50
    },
    "custom/playing": {
        "exec": "~/.config/waybar/scripts/playing.sh",
        "escape": true,
        "tooltip": false
    },
    "temperature": {
	"thermal-zone": 2,
    	"critical-threshold": 80,
	"format": "{icon} {temperatureC}°C",
    	"format-icons": ["", "", " "]
    },
    "network": {
	"interval": 1,
	"format-wifi": "󰤨  {essid} | ",
	"format-ethernet": "  | ",
	"format-disconnected": "󰟦  | ",
	"tooltip-format": "Network_Strength: ({signalStrength}%)",
	"on-click": "~/.config/waybar/scripts/control.sh"
    },
    "wireplumber": {
        "format": "{icon}  {volume}% | ",
        "format-muted": " Muted",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
        "format-icons": [
            "",
            "",
            ""
        ]
    },
    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.sh",
        "format": "{}",
        "return-type": "json",
        "actions": {
            "on-click-right": "mode"
        }
    },
    "battery": {
	"states": {
		"warning": 20,
		"critical": 15,
		"good": 80
	},
        "interval": 1,
        "format": "{icon} {capacity}% ",
        "format-icons": {
            "default": [
                "󰂎",
                "󰁺",
                "󰁻",
                "󰁼",
                "󰁽",
                "󰁾",
                "󰁿",
                "󰂀",
                "󰂁",
                "󰂂",
                "󰁹"
            ],
            "charging": [
                "󰢟",
                "󰢜",
                "󰂆",
                "󰂇",
                "󰂈",
                "󰢝",
                "󰂉",
                "󰢞",
                "󰂊",
                "󰂋",
                "󰂅"
            ]
        }
    },
    "clock": {
        "format": "| {:%a, %d %b  %H:%M}"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": "",
            "active": "",
            "default": ""
        }
    }
}
